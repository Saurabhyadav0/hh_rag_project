# Sarvam Speech-to-Text API Configuration
SARVAM_API_KEY=your_sarvam_api_key_here

# RAG Generator Configuration
# GENERATOR_PROVIDER selects the backend explicitly; leave unset to auto-pick
# by API key presence -- priority order Gemini > Claude > Groq. Gemini also
# falls back to Groq at runtime if the Gemini call itself fails.
GENERATOR_PROVIDER=local
GENERATOR_MODEL_NAME=local-default
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-3.6-flash
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL_NAME=claude-haiku-4-5-20251001
GROQ_API_KEY=your_groq_api_key_here

# Retrieval Weights & Thresholds
RETRIEVAL_TOP_K=3
FAISS_WEIGHT=0.7
BM25_WEIGHT=0.3
MIN_RELEVANCE_SCORE=0.30
